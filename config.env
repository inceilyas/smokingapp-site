# Sitenin tek ayar dosyasi. Degistirdikten sonra ./build.py calistir.
# APP_NAME: Turkce sayfalardaki ad. APP_NAME_EN: TR disindaki tum dillerin adi. Tek bir dil farkli olacaksa
# APP_NAME_<KOD> (ornek APP_NAME_DE, APP_NAME_PT_BR, APP_NAME_ZH_HANS) ile ezilir.
# Magaza adi kesinlesince burayi degistir (gecici ad).
APP_NAME=Nefes Al
APP_NAME_EN=Breathe In
# SUPPORT_EMAIL: gercek destek adresiyle degistir. Simdilik yer tutucu belirtec.
SUPPORT_EMAIL=miselylab@gmail.com
# DEVELOPER_NAME: gizlilik politikasinda "veri sorumlusu" olarak gecen ad.
DEVELOPER_NAME=Mehmet İlyas İnce (Miselylab)
# SITE_URL: GitHub Pages adresi (sonunda / olmadan).
SITE_URL=https://inceilyas.github.io/smokingapp-site
# Politikalarin gecerlilik tarihleri, dil basina gosterim metni: EFFECTIVE_DATE_<KOD> (TR, EN, DE, FR, IT, ES, PT_BR, RU, JA, KO, ZH_HANS).
EFFECTIVE_DATE_TR=30 Eylül 2026
EFFECTIVE_DATE_EN=September 30, 2026
EFFECTIVE_DATE_DE=30. September 2026
EFFECTIVE_DATE_FR=30 septembre 2026
EFFECTIVE_DATE_IT=30 settembre 2026
EFFECTIVE_DATE_ES=30 de septiembre de 2026
EFFECTIVE_DATE_PT_BR=30 de setembro de 2026
EFFECTIVE_DATE_RU=30 сентября 2026 г.
EFFECTIVE_DATE_JA=2026年9月30日
EFFECTIVE_DATE_KO=2026년 9월 30일
EFFECTIVE_DATE_ZH_HANS=2026年9月30日
